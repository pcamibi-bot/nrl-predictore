// NRL PREDICTOR ENGINE - ROUND 4 CALIBRATION
function getPrediction(teamA, teamB) {
    console.log(`\n=== MATCH: ${teamA.name} vs ${teamB.name} ===`);
    
    // Formula: (AvgPts * 0.2) + (Completion * 0.3) + (Discipline * 0.4) + HomeBonus
    const calc = (t, isHome) => (t.h * 0.2) + (t.c * 0.3) + (t.d * 0.4) + (isHome ? 5 : 0);

    const scoreA = calc(teamA, true);
    const scoreB = calc(teamB, false);

    console.log(`${teamA.name} Power Rank: ${scoreA.toFixed(2)}`);
    console.log(`${teamB.name} Power Rank: ${scoreB.toFixed(2)}`);

    const favorite = scoreA > scoreB ? teamA.name : teamB.name;
    const margin = Math.abs(scoreA - scoreB).toFixed(1);
    
    console.log(`PREDICTED WINNER: ${favorite} by ~${margin} points`);
}

